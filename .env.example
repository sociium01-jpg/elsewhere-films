# Public site (set this to the live Vercel URL, e.g. https://elsewhere-films.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload — generate a long random string for PAYLOAD_SECRET
PAYLOAD_SECRET=
PAYLOAD_ADMIN_EMAIL=admin@elsewherefilms.local
PAYLOAD_ADMIN_PASSWORD=

# Supabase Postgres (use the transaction pooler URI on port 6543 for serverless)
# Example: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URI=

# Supabase Storage (S3-compatible). Leave blank to store uploads on local disk during development.
# Dashboard: Project Settings → Storage → S3 connection
S3_BUCKET=media
S3_REGION=ap-south-1
S3_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Contact form (set these in Vercel → Project → Settings → Environment Variables)
# Selection order: Resend → Web3Forms → CONTACT_FORM_ENDPOINT. Never fake success.
RESEND_API_KEY=
CONTACT_TO_EMAIL=am@sociium.in
# Optional. Use a Resend-verified sender, or leave unset for onboarding@resend.dev.
CONTACT_FROM_EMAIL=
# Preferred launch path if Resend is not available. Create a key at web3forms.com
# pointed at am@sociium.in, then set it here (server-side only).
WEB3FORMS_ACCESS_KEY=
# Optional Formspree URL (https://formspree.io/f/<id>), used only if Resend and
# WEB3FORMS_ACCESS_KEY are both unset. Web3Forms URL with ?access_key= also works.
CONTACT_FORM_ENDPOINT=
